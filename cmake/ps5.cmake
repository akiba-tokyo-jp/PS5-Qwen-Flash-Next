set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
foreach(name PS5_PAYLOAD_SDK PS5_LLVM_BIN)
    if(NOT DEFINED ENV{${name}})
        message(FATAL_ERROR "Set ${name}")
    endif()
endforeach()
file(TO_CMAKE_PATH "$ENV{PS5_PAYLOAD_SDK}" sdk)
file(TO_CMAKE_PATH "$ENV{PS5_LLVM_BIN}" llvm)
set(CMAKE_C_COMPILER "${llvm}/clang.exe")
set(CMAKE_CXX_COMPILER "${llvm}/clang++.exe")
set(CMAKE_AR "${llvm}/llvm-ar.exe" CACHE FILEPATH "")
set(CMAKE_RANLIB "${llvm}/llvm-ranlib.exe" CACHE FILEPATH "")
set(CMAKE_C_COMPILER_AR "${llvm}/llvm-ar.exe")
set(CMAKE_CXX_COMPILER_AR "${llvm}/llvm-ar.exe")
set(CMAKE_C_COMPILER_RANLIB "${llvm}/llvm-ranlib.exe")
set(CMAKE_CXX_COMPILER_RANLIB "${llvm}/llvm-ranlib.exe")
set(base "--no-default-config --target=x86_64-sie-ps5 -fno-stack-protector -fno-plt -femulated-tls -fdenormal-fp-math=ieee -fvisibility-nodllstorageclass=default")
set(CMAKE_C_FLAGS_INIT "${base} -isysroot \"${sdk}\" -isystem \"${sdk}/target/include\"")
set(CMAKE_CXX_FLAGS_INIT "${base} -isysroot \"${sdk}\" -nostdinc++ -isystem \"${sdk}/target/include/c++/v1\" -isystem \"${sdk}/target/include\" -fexceptions -fcxx-exceptions -frtti")
set(CMAKE_FIND_ROOT_PATH "${sdk}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(MATH_LIBRARY SceLibcInternal CACHE STRING "" FORCE)
