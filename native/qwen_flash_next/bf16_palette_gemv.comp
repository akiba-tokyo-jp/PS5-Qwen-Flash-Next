#version 450
#ifndef PALETTE_GEMV
#error Compile the raw and palette pipelines separately
#endif
// Both modes accumulate original BF16 values in F32 in the same fixed order.
// The exact integer loader is checked against bf16_palette_decode.comp.
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Encoded { uint data[]; } source;
layout(set=0,binding=1,std430) writeonly buffer Results { uint data[]; } target;
layout(push_constant) uniform Bounds { uint columns; uint rows; uint palette; uint encoded_bytes; } limits;
uint byte_at(uint offset) {
    return (source.data[offset/4]>>((offset%4)*8))&255u;
}
uint original_bits(uint i) {
    const uint tile=i/64u,j=i%64u,part=j/32u,shift=j%32u;
    const uint map=source.data[5]/4u+tile*6u;
    const uint a=source.data[map+part],b=source.data[map+2u+part],c=source.data[map+4u+part];
    const uint code=((a>>shift)&1u)|(((b>>shift)&1u)<<1u)|(((c>>shift)&1u)<<2u);
    uint exponent;
    if(code!=0u)exponent=byte_at(47u+code);
    else {
        const uint prior_mask=shift==0u?0u:(0xffffffffu>>(32u-shift));
        uint rank=uint(bitCount((~(a|b|c))&prior_mask));
        if(part!=0u)rank+=uint(bitCount(~(source.data[map]|source.data[map+2u]|source.data[map+4u])));
        const uint prefix=source.data[source.data[6]/4u+tile];
        exponent=byte_at(source.data[7]+prefix+rank);
    }
    const uint sm=byte_at(source.data[4]+i);
    return ((sm&128u)<<8u)|(exponent<<7u)|(sm&127u);
}
shared float partial[64];
void main() {
    const uint row=gl_WorkGroupID.x,lane=gl_LocalInvocationID.x;
    if(row>=limits.rows)return;
    precise float sum=0.0;
    for(uint column=lane;column<limits.columns;column+=64u) {
        const uint i=row*limits.columns+column;
#if PALETTE_GEMV
        const uint bits=original_bits(i);
#else
        const uint bits=(source.data[i/2u]>>((i%2u)*16u))&65535u;
#endif
        const float weight=uintBitsToFloat(bits<<16u);
        const float input_value=float(int(column%7u)-3)*0.5;
        precise float product=weight*input_value;
        sum=sum+product;
    }
    partial[lane]=sum;barrier();
    for(uint stride=32u;stride>0u;stride>>=1u) {
        if(lane<stride)partial[lane]=partial[lane]+partial[lane+stride];
        barrier();
    }
    if(lane==0u)target.data[row]=floatBitsToUint(partial[0]);
}
