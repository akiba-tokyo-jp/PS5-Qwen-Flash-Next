#version 450
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Original {uint data[];} source;
layout(set=0,binding=1,std430) writeonly buffer Copied {uint data[];} target;
layout(push_constant) uniform Bounds {uint values;uint source_bytes;} limits;
void main() {
    const uint i=gl_GlobalInvocationID.x;
    if(i<limits.values/2u)target.data[i]=source.data[i];
}
