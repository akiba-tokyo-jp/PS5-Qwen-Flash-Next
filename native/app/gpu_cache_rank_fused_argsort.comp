// Derived from pinned llama.cpp argsort.comp (MIT). Preserve its complete
// bitonic comparison/order schedule, including tie permutations. Only the
// current512-column one/two-row path reads prepublished cache coefficients.
#version 450
#extension GL_EXT_control_flow_attributes : enable
layout(constant_id=0) const int BLOCK_SIZE=1024;
layout(constant_id=1) const int NCOLS_PADDED_LOG2=10;
// Keep logical sort width independent of physical lanes. Four logical values
// per lane cover512 entries with128 lanes and the identical barrier schedule.
layout(local_size_x=128,local_size_y=1,local_size_z=1) in;
layout(binding=0) readonly buffer A {float data_a[];};
layout(binding=1) readonly buffer C {float coefficient[];};
layout(binding=2) writeonly buffer D {int data_d[];};
layout(push_constant) uniform Parameter {
    uint ncols,ncols_padded,ncols_padded_log2,nrows,order;
    uint outer_start,outer_end,inner_start,inner_end;
} p;
shared ivec2 dst_row[BLOCK_SIZE];
void argsort(bool needs_bounds_check,const uint row){
    const uint row_offset=row*p.ncols;
    for(int col=int(gl_LocalInvocationID.x);col<BLOCK_SIZE;col+=128){
    ivec2 value=ivec2(col,0);
    if(!needs_bounds_check||col<p.ncols){
        float score=data_a[row_offset+col];
        if(p.ncols==512u&&p.nrows<=2u){
            precise float weighted=score*coefficient[row_offset+col];
            score=weighted;
        }
        value.y=floatBitsToInt(score);
    }
    // All coefficient reads feed these shared stores before the barrier.
    // Binding1 aliases binding2; result stores occur only after the full sort.
    dst_row[col]=value;
    }
    barrier();
    uint num_outer_loop_iters=NCOLS_PADDED_LOG2;
    [[unroll]] for(uint k=2,outer_idx=0;outer_idx<num_outer_loop_iters;k*=2,outer_idx++){
        uint num_inner_loop_iters=outer_idx+1;
        [[unroll]] for(uint j=k/2,inner_idx=0;inner_idx<num_inner_loop_iters;j/=2,inner_idx++){
            for(int col=int(gl_LocalInvocationID.x);col<BLOCK_SIZE;col+=128){
            const int ixj=int(col^j);
            if(ixj>col){
                int idx_0=(col&k)==0?col:ixj;
                int idx_1=(col&k)==0?ixj:col;
                ivec2 sh_idx_0=dst_row[idx_0],sh_idx_1=dst_row[idx_1];
                bool idx_0_oob=needs_bounds_check?sh_idx_0.x>=p.ncols:false;
                bool idx_1_oob=needs_bounds_check?sh_idx_1.x>=p.ncols:false;
                if(idx_0_oob||(!idx_1_oob&&intBitsToFloat(sh_idx_0.y)>intBitsToFloat(sh_idx_1.y))){
                    dst_row[idx_0]=sh_idx_1;dst_row[idx_1]=sh_idx_0;
                }
            }
            }
            barrier();
        }
    }
    for(int col=int(gl_LocalInvocationID.x);col<BLOCK_SIZE;col+=128)
        if(col<p.ncols)data_d[row_offset+(p.order==0u?uint(col):p.ncols-uint(col)-1u)]=dst_row[col].x;
}
void main(){
    uint row=gl_WorkGroupID.y;
    while(row<p.nrows){
        argsort(p.ncols!=BLOCK_SIZE,row);
        row+=gl_WorkGroupSize.y*gl_NumWorkGroups.y;
    }
}
