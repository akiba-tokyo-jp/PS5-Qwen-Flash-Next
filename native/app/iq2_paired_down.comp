#version 450
#extension GL_GOOGLE_include_directive : require
#if defined(QWEN_DOWN_BUFFER_TABLES)
layout(set=0,binding=4,std430) readonly buffer Tables {uvec2 grid[256];uint signs[128];} tables;
uvec2 grid_at(uint index){return tables.grid[index];}
uint signs_at(uint index){return tables.signs[index];}
#else
#include "paired_iq2_tables.glsl"
uvec2 grid_at(uint index){return iq2_grid[index];}
uint signs_at(uint index){return iq2_signs[index];}
#endif
#ifndef QWEN_DOWN_WORKGROUP
#define QWEN_DOWN_WORKGROUP 64
#endif
layout(local_size_x=QWEN_DOWN_WORKGROUP) in;
layout(set=0,binding=0,std430) readonly buffer Weights {uint words[];} weights;
layout(set=0,binding=1,std430) readonly buffer Inputs {float values[];} inputs;
layout(set=0,binding=2,std430) readonly buffer IDs {uint values[];} ids;
layout(set=0,binding=3,std430) buffer Outputs {float values[];} outputs;
layout(push_constant) uniform Geometry {uint width;uint selected;uint planes;uint output_offset;} geometry;
shared float partial[QWEN_DOWN_WORKGROUP];
uint byte_at(uint address){return (weights.words[address>>2]>>((address&3u)*8u))&255u;}
uint u16_at(uint address){return byte_at(address)|(byte_at(address+1u)<<8u);}
uint u32_at(uint address){return u16_at(address)|(u16_at(address+2u)<<16u);}
float decode(uint plane,uint row,uint column){
    const uint logical=(row&1u)*640u+column,within=logical&255u;
    const uint block=plane*422400u+(row>>1u)*330u+(logical>>8u)*66u;
    const uint group=block+2u+(within>>5u)*8u;
    const uint codes=u32_at(group+4u),sub=(within&31u)>>3u,bit=within&7u;
    const uvec2 grid=grid_at(byte_at(group+sub));
    const uint magnitude=((bit<4u?grid.x:grid.y)>>((bit&3u)*8u))&255u;
    const uint sign=signs_at((codes>>(7u*sub))&127u);
    precise float scale=unpackHalf2x16(u16_at(block)).x;
    precise float delta=scale*(0.5+float(codes>>28u))*0.25;
    precise float value=(delta*float(magnitude))*((sign&(1u<<bit))!=0u?-1.0:1.0);
    return value;
}
void main(){
    const uint row=gl_WorkGroupID.x,slot=gl_WorkGroupID.y,token=gl_WorkGroupID.z,lane=gl_LocalInvocationID.x;
    // Every condition is uniform within a workgroup, including all returns
    // before the reduction barriers. Invalid geometry never issues a load.
    if(row>=2560u||slot>=geometry.selected||token>=geometry.width||geometry.selected==0u||geometry.selected>10u||geometry.width>32u)return;
    const uint selection=token*geometry.selected+slot;
    if(selection>=ids.values.length())return;
    const uint plane=ids.values[selection];
    if(plane>=geometry.planes||geometry.planes>10u||weights.words.length()<geometry.planes*105600u||
        inputs.values.length()<(selection+1u)*640u||geometry.output_offset>uint(outputs.values.length())||
        (selection+1u)*2560u>uint(outputs.values.length())-geometry.output_offset)return;
    precise float sum=0.0;
    for(uint column=lane;column<640u;column+=QWEN_DOWN_WORKGROUP)sum+=decode(plane,row,column)*inputs.values[selection*640u+column];
    partial[lane]=sum;barrier();
    for(uint distance=QWEN_DOWN_WORKGROUP/2u;distance>0u;distance>>=1u){
        if(lane<distance)partial[lane]+=partial[lane+distance];barrier();
    }
    if(lane==0u)outputs.values[geometry.output_offset+selection*2560u+row]=partial[0];
}
