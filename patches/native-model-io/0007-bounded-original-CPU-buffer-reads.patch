+// One serialized native producer uses a fixed metadata arena. Retain the
+// original graph/hash capacities and validate the complete active graph before
+// creating any scheduler tensor copies; never truncate nodes to fit this arena.
+static constexpr size_t qwen_app_scheduler_context_budget = size_t(192) << 20;
+static size_t qwen_app_scheduler_context_required(size_t nodes) {
+    const size_t per_node = GGML_SCHED_MAX_SPLIT_INPUTS * 2 * ggml_tensor_overhead();
+    if (!nodes || !per_node || nodes > qwen_app_scheduler_context_budget / per_node)
+        throw std::runtime_error("Complete graph exceeds the bounded scheduler metadata arena");
+    const size_t tensors = nodes * per_node;
+    const size_t graph = ggml_graph_overhead_custom(nodes, false);
+    if (graph > qwen_app_scheduler_context_budget - tensors)
+        throw std::runtime_error("Complete graph metadata exceeds its native CPU budget");
+    return tensors + graph;
+}
