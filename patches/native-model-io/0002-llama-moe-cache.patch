+    void predict_next_expert(int32_t il,group &g) {
+        if(!forecast)return;
+        if(predicted_layer>=0) {
+            if(predicted_layer==il&&std::find(ids.begin(),ids.end(),predicted_expert)!=ids.end())++predictive_stats.useful;
+            else ++predictive_stats.unused;
+            predicted_layer=predicted_expert=-1;
+        }
+        forecast->observe(unsigned(il),unsigned(ids.size()/10),ids.data(),ids.size());
+        if(ids.size()!=10||il>=47||layers[il+1].ig!=layers[il].ig)return;
+        const auto expert=forecast->predict(unsigned(il+1),g.slru.key_of);
+        if(expert<0)return;
+        ++predictive_stats.proposals;
+        if(!g.slru.adaptive||g.banks.size()!=3||layers[il+1].experts.size()!=3)
+            throw std::runtime_error("Predictive caching requires the actual three original BF16 banks and LFU policy");
+        // policy.victim protects every Expert in the just-selected current
+        // route. The predicted slot is never used by the overlapping graph.
+        const auto slot=g.slru.policy.victim(g.slru.key_of,il,g.slru.uniq);
+        if(slot<0){++predictive_stats.ineligible;return;}
+        const auto &next=layers[il+1];
+        const void *sources[3];std::size_t residues[3];
+        for(unsigned role=0;role<3;++role) {
+            const auto *w=next.experts[role];
+            if(w->type!=GGML_TYPE_BF16||w->nb[2]!=qwen_app::bank_expert_bytes||w->ne[2]!=512)
+                throw std::runtime_error("Predicted Expert precision or layout differs");
+            sources[role]=static_cast<const uint8_t *>(w->data)+expert*w->nb[2];
+            residues[role]=bindings.at(w).cached->view_offs;
+        }
+        if(!qwen_app_begin_predictive_expert(g.banks.data(),sources,slot,residues)) {
+            ++predictive_stats.ineligible;return;
+        }
+        // All source/destination eligibility is decided before this metadata
+        // publication. The next copy must observe positive read completion.
+        const auto old=g.slru.key_of[slot];
+        if(old>=0)g.slru.slot_map[old/512][old%512]=-1;
+        g.slru.key_of[slot]=(il+1)*512+expert;
+        g.slru.slot_map[il+1][expert]=slot;g.slru.move(slot,false);
+        predicted_layer=il+1;predicted_expert=expert;
+        ++predictive_stats.loads;predictive_stats.logical_bytes+=3*qwen_app::bank_expert_bytes;
+        app_upload.fetch_add(3*qwen_app::bank_expert_bytes,std::memory_order_relaxed);
+    }
