+    static void scatter_padded(ggml_tensor *bank,const void *source,size_t first_slot,size_t count,size_t residue) {
+        const size_t total=count*qwen_app::bank_expert_bytes;
+        if(!count||first_slot>=qwen_app::selected_padded_cache_geometry().active_slots||count>qwen_app::selected_padded_cache_geometry().active_slots-first_slot||!qwen_app_model_source_range(source,total))
+            throw std::runtime_error("Padded scatter requires complete owned original expert bytes");
+        qwen_app_record_padded_scatter(total);
+        for(size_t done=0;done<total;) {
+            size_t part=0;
+            const auto *window=static_cast<const uint8_t *>(qwen_app_model_source_chunk(
+                static_cast<const uint8_t *>(source)+done,total-done,&part));
+            if(!part||part>total-done)throw std::runtime_error("Padded scatter source did not advance");
+            for(size_t consumed=0;consumed<part;) {
+                const auto position=done+consumed;
+                const auto inside=position%qwen_app::bank_expert_bytes;
+                const auto bytes=std::min(part-consumed,qwen_app::bank_expert_bytes-inside);
+                const auto slot=first_slot+position/qwen_app::bank_expert_bytes;
+                ggml_backend_tensor_set(bank,window+consumed,slot*bank->nb[2]+residue+inside,bytes);
+                consumed+=bytes;
+            }
+            qwen_app_model_source_chunk_completed();done+=part;
+        }
     }
 
