+extern "C" bool llama_app_expert_policy_enabled() {
+    const char * policy = std::getenv("LLAMA_APP_EXPERT_POLICY");
+    return policy && std::strcmp(policy, "maya-aged-lfu") == 0;
+}
+
+extern "C" void llama_app_expert_counters(llama_app_expert_stats * result) {
+    if (result) *result = {app_hits.load(std::memory_order_relaxed), app_misses.load(std::memory_order_relaxed),
+        app_upload.load(std::memory_order_relaxed), app_advice.load(std::memory_order_relaxed)};
+}
+
+static size_t app_advise_expert(const void * source, size_t bytes, size_t & budget) {
+#if defined(__unix__) || defined(__APPLE__)
+    const long page = sysconf(_SC_PAGESIZE);
+    if (page <= 0) return 0;
+    const auto range = qwen_app::expert_advice_range(reinterpret_cast<uintptr_t>(source), bytes, size_t(page), budget);
+    if (!range.bytes) return 0;
+    budget -= range.bytes;
+    return madvise(reinterpret_cast<void *>(range.address), range.bytes, MADV_WILLNEED) == 0 ? range.bytes : 0;
+#else
+    (void) source; (void) bytes; (void) budget;
+    return 0;
+#endif
+}
 
